{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agentctl fleet launch template",
  "description": "A schema-valid template can still be refused at launch: harness, model, and effort value rules apply to the merged union of template fields and command-line overrides, not to this file alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "dir": {
      "type": "string",
      "pattern": "^/"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "harness": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
